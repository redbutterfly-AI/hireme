<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F4F8">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="#1565C0" android:padding="14dp" android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageButton android:id="@+id/btnBack" android:layout_width="36dp" android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_revert" android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@android:color/white" android:contentDescription="Back"
            xmlns:app="http://schemas.android.com/apk/res-auto"/>
        <TextView android:text="Seeker Profile" android:textSize="16sp" android:textStyle="bold"
            android:textColor="@android:color/white" android:layout_marginStart="10dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="#0D1B2A" android:padding="20dp" android:orientation="vertical"
                android:gravity="center">
                <FrameLayout android:layout_width="72dp" android:layout_height="72dp" android:layout_marginBottom="10dp">
                    <TextView android:id="@+id/tvSeekerInitials" android:layout_width="72dp"
                        android:layout_height="72dp" android:gravity="center" android:textSize="26sp"
                        android:textStyle="bold" android:textColor="@android:color/white" android:background="#1565C0"/>
                    <ImageView android:id="@+id/imgSeekerProfile" android:layout_width="72dp"
                        android:layout_height="72dp" android:scaleType="centerCrop" android:visibility="gone"
                        android:contentDescription="Profile"/>
                </FrameLayout>
                <TextView android:id="@+id/tvSeekerName" android:text="Name" android:textSize="18sp"
                    android:textStyle="bold" android:textColor="@android:color/white"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/tvSeekerRole" android:text="Job Seeker" android:textSize="12sp"
                    android:textColor="#90CAF9" android:layout_marginTop="4dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/tvSeekerRating" android:text="No ratings" android:textSize="13sp"
                    android:textColor="#FFD700" android:layout_marginTop="6dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@android:color/white"
                android:padding="16dp" android:layout_margin="12dp">
                <TextView android:text="Contact" android:textSize="14sp" android:textStyle="bold"
                    android:textColor="#0D1B2A" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="6dp">
                    <TextView android:text="Email: " android:textSize="13sp" android:textStyle="bold"
                        android:textColor="#555" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/tvSeekerEmail" android:text="-" android:textSize="13sp"
                        android:textColor="#333" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:text="Phone: " android:textSize="13sp" android:textStyle="bold"
                        android:textColor="#555" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/tvSeekerPhone" android:text="-" android:textSize="13sp"
                        android:textColor="#333" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@android:color/white"
                android:padding="16dp" android:layout_marginStart="12dp" android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp">
                <TextView android:text="Skills &amp; What I Can Do" android:textSize="14sp"
                    android:textStyle="bold" android:textColor="#0D1B2A"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"/>
                <TextView android:id="@+id/tvSeekerBio" android:text="No description yet."
                    android:textSize="13sp" android:textColor="#333" android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="12dp">
                <TextView android:text="Portfolio" android:textSize="14sp" android:textStyle="bold"
                    android:textColor="#0D1B2A" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>
                <TextView android:id="@+id/tvPortfolioEmpty" android:text="No portfolio items yet."
                    android:textSize="13sp" android:textColor="#888" android:visibility="gone"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerPortfolio"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
