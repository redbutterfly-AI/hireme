<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F4F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1a1a2e"
        android:padding="16dp"
        android:orientation="vertical">
        <TextView android:text="Admin panel" android:textSize="12sp" android:textColor="#AAAAAA"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="HireMe control" android:textSize="17sp" android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPendingCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading pending jobs..."
                android:textSize="13sp"
                android:textColor="#888888"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="4dp"/>

            <TextView
                android:id="@+id/tvEmployerCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading employers..."
                android:textSize="13sp"
                android:textColor="#888888"
                android:paddingStart="16dp"
                android:paddingBottom="8dp"/>

            <TextView android:text="Pending job approvals" android:textSize="13sp"
                android:textStyle="bold" android:textColor="#0D1B2A"
                android:layout_marginStart="12dp" android:layout_marginBottom="6dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerPendingJobs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="12dp"/>

            <TextView android:text="Registered employers" android:textSize="13sp"
                android:textStyle="bold" android:textColor="#0D1B2A"
                android:layout_marginStart="12dp" android:layout_marginBottom="6dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerEmployers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Log out"
                android:textColor="#C62828"
                android:backgroundTint="#FFEBEE"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>