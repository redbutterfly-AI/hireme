<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1B2A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1565C0"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/btnBackForgot"
            android:text="&#8592;"
            android:textSize="22sp"
            android:textColor="@android:color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:clickable="true"
            android:focusable="true"/>
        <TextView
            android:text="Reset password"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Step 1: Enter email -->
            <LinearLayout
                android:id="@+id/layoutStep1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:padding="20dp">

                <TextView android:text="Forgot your password?"
                    android:textSize="18sp" android:textStyle="bold" android:textColor="#0D1B2A"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"/>
                <TextView android:text="Enter your email address and we will send you a reset code."
                    android:textSize="13sp" android:textColor="#666666"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"/>
                <TextView android:text="EMAIL ADDRESS" android:textSize="11sp"
                    android:textStyle="bold" android:textColor="#1565C0"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/etResetEmail"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Enter your email"
                    android:inputType="textEmailAddress"
                    android:padding="12dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"/>
                <Button
                    android:id="@+id/btnSendCode"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Send reset code"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#1565C0"/>
            </LinearLayout>

            <!-- Step 2: Enter code -->
            <LinearLayout
                android:id="@+id/layoutStep2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:padding="20dp"
                android:visibility="gone">

                <TextView android:text="Enter reset code"
                    android:textSize="18sp" android:textStyle="bold" android:textColor="#0D1B2A"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"/>
                <TextView android:text="We sent a 6-digit code to your email. Enter it below."
                    android:textSize="13sp" android:textColor="#666666"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"/>
                <TextView android:text="RESET CODE" android:textSize="11sp"
                    android:textStyle="bold" android:textColor="#1565C0"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/etResetCode"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Enter 6-digit code"
                    android:inputType="number"
                    android:maxLength="6"
                    android:gravity="center"
                    android:textSize="22sp"
                    android:letterSpacing="0.3"
                    android:padding="12dp"
                    android:layout_marginBottom="16dp"/>
                <Button
                    android:id="@+id/btnVerifyCode"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Verify code"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#1565C0"
                    android:layout_marginBottom="12dp"/>
                <TextView
                    android:id="@+id/tvResendCode"
                    android:text="Didn't receive a code? Resend"
                    android:textSize="13sp"
                    android:textColor="#1565C0"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <!-- Step 3: New password -->
            <LinearLayout
                android:id="@+id/layoutStep3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:padding="20dp"
                android:visibility="gone">

                <TextView android:text="Set new password"
                    android:textSize="18sp" android:textStyle="bold" android:textColor="#0D1B2A"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"/>
                <TextView android:text="Choose a strong password for your account."
                    android:textSize="13sp" android:textColor="#666666"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"/>
                <TextView android:text="NEW PASSWORD" android:textSize="11sp"
                    android:textStyle="bold" android:textColor="#1565C0"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/etNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Enter new password"
                    android:inputType="textPassword"
                    android:padding="12dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"/>
                <TextView android:text="CONFIRM PASSWORD" android:textSize="11sp"
                    android:textStyle="bold" android:textColor="#1565C0"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Confirm new password"
                    android:inputType="textPassword"
                    android:padding="12dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"/>
                <Button
                    android:id="@+id/btnResetPassword"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Reset password"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#1565C0"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
